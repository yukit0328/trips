<script>
(function(){
  var E = encodeURIComponent;
  var TAG = document.body.getAttribute('data-tag') || '旅のしおり';
  function gdate(s){ return s.replace(/-/g,'').replace(':','') + '00'; }
  document.querySelectorAll('[data-cal]').forEach(function(a){
    try{
      var c = JSON.parse(a.getAttribute('data-cal'));
      a.href = 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=' + E(c.t)
        + '&dates=' + gdate(c.s) + '/' + gdate(c.e) + '&ctz=Asia/Tokyo'
        + (c.l ? '&location=' + E(c.l) : '') + '&details=' + E((c.d ? c.d + '\n' : '') + '（' + TAG + '）');
      a.target = '_blank'; a.rel = 'noopener';
    }catch(e){ a.classList.add('na'); a.textContent = 'カレンダー情報エラー'; }
  });
  document.querySelectorAll('[data-dest]').forEach(function(a){
    a.href = 'https://www.google.com/maps/dir/?api=1&destination=' + E(a.getAttribute('data-dest')) + '&travelmode=driving';
    a.target = '_blank'; a.rel = 'noopener';
  });
  document.querySelectorAll('[data-q]').forEach(function(a){
    a.href = 'https://www.google.com/maps/search/?api=1&query=' + E(a.getAttribute('data-q'));
    a.target = '_blank'; a.rel = 'noopener';
  });
  document.querySelectorAll('[data-leg]').forEach(function(a){
    var p = a.getAttribute('data-leg').split('|');
    var url = 'https://www.google.com/maps/dir/?api=1&origin=' + E(p[0]) + '&destination=' + E(p[p.length-1]) + '&travelmode=driving';
    if(p.length > 2){ url += '&waypoints=' + E(p.slice(1,-1).join('|')); }
    a.href = url; a.target = '_blank'; a.rel = 'noopener';
  });
  var KEY = 'plan_' + location.pathname;
  function show(pl, save){
    document.querySelectorAll('.plan-panel').forEach(function(x){ x.hidden = x.getAttribute('data-plan') !== pl; });
    document.querySelectorAll('.ptab').forEach(function(b){ b.setAttribute('aria-selected', b.getAttribute('data-plan') === pl ? 'true' : 'false'); });
    if(save){ try{ localStorage.setItem(KEY, pl); }catch(_){} }
  }
  if(document.querySelector('.ptab')){
    var saved = null; try{ saved = localStorage.getItem(KEY); }catch(_){}
    show(saved || document.querySelector('.ptab').getAttribute('data-plan'), false);
    document.querySelectorAll('.ptab').forEach(function(b){ b.addEventListener('click', function(){ show(b.getAttribute('data-plan'), true); }); });
  }
})();
